// Zed keymap
//
// For information on binding keys, see the Zed
// documentation: https://zed.dev/docs/key-bindings
//
// To see the default key bindings run `zed: open default keymap`
// from the command palette.
[
  {
    "context": "Workspace",
    "bindings": {
      // "shift shift": "file_finder::Toggle"
      "cmd-f cmd-w": [
        "task::Spawn",
        { "task_name": "Find in Files", "reveal_target": "center" }
      ]
    }
  },

  {
    "context": "Editor && vim_mode == insert",
    "bindings": {
      // "j k": "vim::NormalBefore"
    }
  },
  {
    "bindings": {
      "cmd-1": "editor::ToggleFocus"
    }
  },
  {
    "bindings": {
      "cmd-`": "terminal_panel::ToggleFocus"
    }
  },
  {
    "context": "vim_mode == insert",
    "bindings": {
      "cmd-k": "assistant::InlineAssist"
    }
  },
  {
    "context": "vim_mode == insert",
    "bindings": {
      "ctrl-x ctrl-a": null
    }
  },
  {
    "context": "Workspace",
    "bindings": {
      "ctrl-tab": null
    }
  },
  {
    "context": "Editor && vim_mode == normal && vim_operator == none && !VimWaiting",
    "bindings": {
      "space g g": [
        "task::Spawn",
        { "task_name": "Lazygit", "reveal_target": "center" }
      ]
    }
  },
  {
    "context": "Picker > Editor",
    "bindings": {
      "ctrl-h": null
    }
  },
  {
    "context": "vim_mode == literal",
    "bindings": {
      "ctrl-h": null
    }
  },
  {
    "context": "Editor",
    "bindings": {
      "ctrl-h": null
    }
  },
  {
    "context": "(VimControl || (!Editor && !Terminal))",
    "bindings": {
      "ctrl-h": "workspace::ActivatePaneLeft"
    }
  },
  {
    "context": "(VimControl || (!Editor && !Terminal))",
    "bindings": {
      "ctrl-shift-h": "workspace::SwapPaneLeft"
    }
  },
  {
    "context": "(VimControl || (!Editor && !Terminal))",
    "bindings": {
      "ctrl-w shift-h": null
    }
  },
  {
    "context": "(VimControl || (!Editor && !Terminal))",
    "bindings": {
      "ctrl-shift-l": "workspace::SwapPaneRight"
    }
  },
  {
    "context": "(VimControl || (!Editor && !Terminal))",
    "bindings": {
      "ctrl-w shift-l": null
    }
  },
  {
    "context": "vim_mode == literal",
    "bindings": {
      "ctrl-l": null
    }
  },
  {
    "context": "Editor",
    "bindings": {
      "ctrl-l": null
    }
  },
  {
    "context": "(VimControl || (!Editor && !Terminal))",
    "bindings": {
      "ctrl-l": "workspace::ActivatePaneRight"
    }
  },
  {
    "context": "vim_mode == literal",
    "bindings": {
      "ctrl-k": null
    }
  },
  {
    "context": "Editor",
    "bindings": {
      "ctrl-k": null
    }
  },
  {
    "context": "(VimControl || (!Editor && !Terminal))",
    "bindings": {
      "ctrl-k": "workspace::ActivatePaneUp"
    }
  },
  {
    "context": "(VimControl || (!Editor && !Terminal))",
    "bindings": {
      "ctrl-shift-k": "workspace::SwapPaneUp"
    }
  },
  {
    "context": "(VimControl || (!Editor && !Terminal))",
    "bindings": {
      "ctrl-shift-j": "workspace::SwapPaneDown"
    }
  },
  {
    "context": "vim_mode == literal",
    "bindings": {
      "ctrl-j": null
    }
  },
  {
    "context": "(VimControl || (!Editor && !Terminal))",
    "bindings": {
      "ctrl-j": "workspace::ActivatePaneDown"
    }
  },
  {
    "context": "((VimControl && !menu) || (!Editor && !Terminal))",
    "bindings": {
      "alt-]": "vim::GoToTab"
    }
  },
  {
    "context": "((VimControl && !menu) || (!Editor && !Terminal))",
    "bindings": {
      "alt-[": "vim::GoToPreviousTab"
    }
  },
  {
    "context": "FileFinder",
      "bindings": {
      "ctrl-h": "search::ToggleIncludeIgnored"
    }
  }
]
